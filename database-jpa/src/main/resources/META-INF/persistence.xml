<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
  xmlns="https://jakarta.ee/xml/ns/persistence"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

  <persistence-unit name="folder-inspector-jpa">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>dev.ayam.folderinspector.database.jpa.entity.ItemEntity</class>
    <class>dev.ayam.folderinspector.database.jpa.entity.AclItemEntity</class>
    <class>dev.ayam.folderinspector.database.jpa.entity.PrincipalEntity</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:${user.home}/.folder-inspector/snapshots/jpa_snapshot.db"/>
      <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>

</persistence>
